# Copy to backend/.env and fill in. Never commit backend/.env.

# Scam analysis (OpenRouter, OpenAI model with structured outputs)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna

# Speech to text (faster-whisper, runs on this Mac)
WHISPER_MODEL=small

# Storage
DATABASE_PATH=data/rambu.sqlite3

# Apple push notifications (token auth). Keep the .p8 file outside the repo.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=id.rambu.app

# Development only: a puck token accepted without app pairing (fake puck, serial-configured puck).
DEV_PUCK_TOKEN=
